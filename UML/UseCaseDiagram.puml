@startuml 
left to right direction 
 
 
actor "Tourist" as T 
actor "Admin" as A 
 
rectangle "Tourist Management System" { 
usecase "Login" as UC1 
usecase "Recover Password" as UC2 
usecase "Book Flight" as UC3 
usecase "Book Hotel" as UC4 
usecase "Manage Booking" as UC5 
usecase "Make Payment" as UC6 
usecase "Generate Invoice" as UC7 
usecase "Give Feedback" as UC8 
usecase "View Feedback" as UC9 
 
' Relationships 
UC1 <.. UC2 : <<extend>> 
UC3 ..> UC6 : <<include>> 
UC4 ..> UC6 : <<include>> 
UC6 ..> UC7 : <<include>> 
} 
 
 
' Actor Associations 
T -- UC1 
T -- UC2 
T -- UC3 
T -- UC4 
T -- UC6 
T -- UC8 
 
 
A -- UC1 
A -- UC2 
A -- UC5 
A -- UC7 
A -- UC9 
@enduml 
